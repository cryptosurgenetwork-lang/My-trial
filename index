async function testKey(){localStorage.gkey=$("#gk").value.trim();localStorage.gmodel=$("#gm").value.trim();busy("পরীক্ষা চলছে…");try{await gemini([{text:"শুধু 'ঠিক আছে' লেখো"}]);toast("✅ কী কাজ করছে")}catch(e){toast(e.message)}busy()}
function home(){
  const sv=S.qs.filter(q=>q.saved).length,d=due().length,ok=S.qs.filter(q=>q.lastOk).length;
  const pct=sv?Math.round(ok/sv*100):0,off=(251.3*(1-pct/100)).toFixed(1);
  const subj={};S.qs.forEach(q=>{const a=q.subject||"অন্যান্য";(subj[a]??={n:0,c:new Set()}).n++;subj[a].c.add(q.chapter)});
  const GR=["#7c3aed,#ec4899","#0ea5e9,#10b981","#f59e0b,#ef4444","#6366f1,#22d3ee","#ec4899,#f59e0b","#10b981,#84cc16"];
  const cards=Object.entries(subj).map(([a,v],i)=>`<div class=sc style="background:linear-gradient(135deg,${GR[i%GR.length]});animation-delay:${i*70}ms" data-k="${esc(a)}" onclick="goSub(this.dataset.k)"><b>${esc(a)}</b><small>${bn(v.c.size)} অধ্যায় · ${bn(v.n)} প্রশ্ন</small></div>`).join("");
  const recent=S.qs.slice(0,4).map(q=>`<div style="margin:6px 0"><span class="badge c-${q.cat}">${q.cat}</span>${esc(q.q.slice(0,70))}</div>`).join("")||"এখনো কিছু নেই। নিচের স্ক্যান বাটন থেকে শুরু করুন।";
  return `<div class=hero2><div style="flex:1"><div style="opacity:.92;font-size:14px">${d?"আজকের লক্ষ্য":"দারুণ কাজ!"}</div><h2 style="font-size:23px;margin:2px 0 12px">${d?bn(d)+"টি প্রশ্ন রিভিশন বাকি":"আজকের রিভিশন শেষ"}</h2><button class=glassbtn onclick="go('rev')">রিভিশন শুরু</button></div>
  <svg class=ring viewBox="0 0 100 100"><circle class=tr cx=50 cy=50 r=40></circle><circle class=pg cx=50 cy=50 r=40 stroke-dasharray=251.3 stroke-dashoffset=${off} transform="rotate(-90 50 50)"></circle><text x=50 y=57 text-anchor=middle>${bn(pct)}%</text></svg></div>
  <div class=stats><div class="stat2 s1">${ic(ICO.mark)}<b>${bn(sv)}</b>সংরক্ষিত</div><div class="stat2 s2">${ic(ICO.clock)}<b>${bn(d)}</b>রিভিশন বাকি</div><div class="stat2 s3">${ic(ICO.check)}<b>${bn(ok)}</b>মনে আছে</div></div>
  ${cards?`<div class=h>তোমার বিষয়সমূহ</div><div class=subs>${cards}</div>`:""}
  <div class=card><div class=h style="margin-top:0">সাম্প্রতিক প্রশ্ন</div>${recent}</div>`;
}
function snap(){if(!$("#sub"))return;S.f={sub:$("#sub").value,subx:$("#subx")?.value||"",ch:$("#chs2")?.value||"",chap:$("#chap")?.value||"",txt:$("#txt").value,num:$("#num").value,dif:$("#dif").value,len:$("#len").value,cats:[...document.querySelectorAll(".cc")].map(c=>c.checked)}}
function scan(){
  const f=S.f||{};
  const sel=(l,v,d)=>l.map(o=>`<option ${(v||d)==o?"selected":""}>${o}</option>`).join("");
  const opt=x=>`<option value="${esc(x)}" ${f.sub===x?"selected":""}>${esc(x)}</option>`;
  const known=CURR[f.sub];
  const usedC=[...new Set(S.qs.filter(q=>q.subject===f.sub).map(q=>q.chapter).filter(Boolean))];
  const chapUI=!f.sub?`<div class=sel-note>আগে বিষয় বাছুন</div>`
   :known?`<select id=chs2 onchange="snap();render()"><option value="">— অধ্যায় বাছুন —</option>${known.map((c,i)=>`<option value="${esc(c)}" ${f.ch===c?"selected":""}>${bn(i+1)}. ${esc(c)}</option>`).join("")}<option value="__o" ${f.ch==="__o"?"selected":""}>অন্য (নিজে লিখুন)</option></select>${f.ch==="__o"?`<input id=chap placeholder="অধ্যায়ের নাম" value="${esc(f.chap||"")}">`:""}`
   :`<input id=chap list=chs placeholder="অধ্যায়ের নাম লিখুন" value="${esc(f.chap||"")}"><datalist id=chs>${usedC.map(x=>`<option value="${esc(x)}">`).join("")}</datalist><div class=sel-note>এই বিষয়ের অধ্যায় তালিকা এখনো যোগ হয়নি, নিজে লিখুন।</div>`;
  return `<div class=card><h3>১. কোন বই, কোন অধ্যায়?</h3>
  <select id=sub onchange="snap();S.f.ch='';S.f.chap='';render()"><option value="">— বিষয় / বই বাছুন —</option>
  <optgroup label="অধ্যায় তালিকাসহ">${Object.keys(CURR).map(opt).join("")}</optgroup>
  <optgroup label="অন্যান্য বিষয়">${OTHER_SUBS.map(opt).join("")}</optgroup>
  <option value="__o" ${f.sub==="__o"?"selected":""}>অন্য বিষয় (নিজে লিখুন)</option></select>
  ${f.sub==="__o"?`<input id=subx placeholder="বিষয়ের নাম" value="${esc(f.subx||"")}">`:""}
  ${f.sub==="__o"?`<input id=chap placeholder="অধ্যায়ের নাম" value="${esc(f.chap||"")}">`:chapUI}
  <div class=sel-note>অধ্যায়ের নামগুলো এনসিটিবি সিলেবাস থেকে লেখা। আপনার বইয়ের সংস্করণে আলাদা হলে "অন্য" বেছে নিজে লিখুন।</div></div>
  <div class=card><h3>২. 📸 পৃষ্ঠা যোগ করুন</h3>
  <div class=row><button onclick="$('#cam').click()">ক্যামেরা</button><button class=ghost onclick="$('#gal').click()">গ্যালারি / PDF</button></div>
  <input id=cam type=file accept="image/*" capture=environment hidden onchange="addFiles(this.files)">
  <input id=gal type=file accept="image/*,application/pdf" multiple hidden onchange="addFiles(this.files)">
  <div class=thumb>${S.pages.map((p,i)=>`<div style="position:relative">${p.url?`<img src="${p.url}">`:`<div class=pill style="height:80px;padding:30px 10px">📄 ${esc(p.name.slice(0,12))}</div>`}<button style="position:absolute;top:2px;right:2px;padding:0 8px" class=no onclick="S.pages.splice(${i},1);render()">×</button></div>`).join("")}</div>
  <details><summary>📝 লেখা পেস্ট করতে চান?</summary><textarea id=txt placeholder="ছবি ছাড়াও বইয়ের লেখা এখানে দিতে পারেন">${esc(f.txt||"")}</textarea></details></div>
  <div class=card><details><summary>⚙️ আরও সেটিংস (ক খ গ ঘ সব চালু আছে)</summary>
  <div class=row style="margin:8px 0">${["ক","খ","গ","ঘ"].map((c,i)=>`<label><input class=cc type=checkbox value=${c} ${!f.cats||f.cats[i]?"checked":""} style="width:auto"> <span class="badge c-${c}">${c}</span></label>`).join("")}</div>
  <div class=row><div><label>সংখ্যা</label><select id=num>${[5,8,10,15,20].map(n=>`<option value=${n} ${(f.num||10)==n?"selected":""}>${bn(n)}</option>`).join("")}</select></div><div><label>কঠিনতা</label><select id=dif>${sel(["সহজ","মাঝারি","কঠিন"],f.dif,"মাঝারি")}</select></div><div><label>উত্তর</label><select id=len>${sel(["সংক্ষিপ্ত","মাঝারি","বিস্তারিত"],f.len,"মাঝারি")}</select></div></div></details></div>
  <button style="width:100%;font-size:18px;padding:16px" onclick="scanGo()">🚀 স্ক্যান করে প্রশ্ন বানাও</button>
  <p style="font-size:13px;color:var(--mut)">প্রশ্নগুলো বিষয় ও অধ্যায় অনুযায়ী নিজে থেকে "প্রশ্ন" ট্যাবে জমা হবে। এআই ভুল করতে পারে, তাই উত্তর মিলিয়ে নিন।</p>`;
}
function qcard(q,id,btns){
  const o=S.show[id];
  return `<div class=card><span class="badge c-${q.cat}">${q.cat}</span><span class=pill>${bn(q.marks)} নম্বর</span> <span class=pill>অগ্রাধিকার: ${esc(q.importance)}</span>
  <p style="white-space:pre-wrap"><b>${esc(q.q)}</b></p>
  ${o?`<div class=ans>${esc(q.answer)}${q.explanation?`\n\n💡 ${esc(q.explanation)}`:""}${q.source?`\n📖 ${esc(q.source)}`:""}</div>`:""}
  <div class=row style="margin-top:8px"><button class=ghost onclick="S.show['${id}']=!S.show['${id}'];render()">${o?"উত্তর লুকাও":"উত্তর দেখো"}</button>${btns||""}</div></div>`;
}
function bank(){
  const l=S.qs.filter(q=>S.filter==="সব"||q.cat===S.filter),g={};
  l.forEach(q=>{const a=q.subject||"বিষয় নেই",c=q.chapter||"অধ্যায় নেই";((g[a]??={})[c]??=[]).push(q)});
  const body=Object.entries(g).map(([a,cs])=>`<details class=card data-k="${esc("s:"+a)}" ontoggle="S.open[this.dataset.k]=this.open" ${S.open["s:"+a]===false?"":"open"}><summary><b>📘 ${esc(a)}</b> <span class=pill>${bn(Object.values(cs).flat().length)}</span></summary>
  ${Object.entries(cs).map(([c,qs])=>`<details data-k="${esc(a+"|"+c)}" ontoggle="S.open[this.dataset.k]=this.open" ${S.open[a+"|"+c]?"open":""} style="margin:10px 0"><summary>📖 ${esc(c)} <span class=pill>${bn(qs.length)}</span></summary>${qs.map(q=>qcard(q,q.id,`<button class=ghost onclick="edit('${q.id}')">✏️</button><button class=no onclick="del('${q.id}')">🗑</button>`)).join("")}</details>`).join("")}</details>`).join("");
  return `<div class=row style="margin-bottom:10px">${["সব","ক","খ","গ","ঘ"].map(c=>`<button class="${S.filter===c?"":"ghost"}" onclick="S.filter='${c}';render()">${c}</button>`).join("")}</div>
  ${l.length?`<button class=ghost style="width:100%;margin-bottom:10px" onclick="pdf()">📄 PDF করো</button>`:""}
  ${body||`<div class=card>কোনো প্রশ্ন নেই। স্ক্যান থেকে বানিয়ে নিন।</div>`}`;
}
function rev(){
  const d=due();
  if(!d.length)return `<div class=card style="text-align:center"><div style="font-size:60px">🎉</div><h3>আজকের রিভিশন শেষ!</h3><p>${bn(S.qs.filter(q=>q.saved).length)}টি প্রশ্ন সংরক্ষিত আছে।</p></div>`;
  const q=d[0];
  return `<p style="text-align:center">বাকি: <b>${bn(d.length)}</b>টি। কার্ডে ট্যাপ করে উত্তর দেখুন</p>
  <div class="fc ${S.flip?"f":""}" onclick="S.flip=!S.flip;render()"><div class=fi><div class="face fr"><div><span class="badge c-${q.cat}">${q.cat}</span><br>${esc(q.q)}</div></div><div class="face bk">${esc(q.answer)}</div></div></div>
  ${S.flip?`<div class=row><button class=no onclick="grade(S.qs.find(x=>x.id=='${q.id}'),false)">😅 আবার পড়ব</button><button class=ok onclick="grade(S.qs.find(x=>x.id=='${q.id}'),true)">✅ মনে আছে</button></div>`:""}`;
}
function set(){
  return `<div class=card><h3>🔑 Gemini API কী</h3><p style="font-size:13px;color:var(--mut)">কী শুধু এই ডিভাইসের ব্রাউজারে থাকে। Google AI Studio-তে কীটি আপনার সাইটের ডোমেইনে সীমাবদ্ধ করে রাখুন।</p>
  <input id=gk type=password placeholder="AIza… বা AQ.…" value="${esc(localStorage.gkey||"")}"><input id=gm placeholder="মডেল (ঐচ্ছিক, যেমন gemini-2.5-flash)" value="${esc(localStorage.gmodel||"")}">
  <div class=row><button onclick="localStorage.gkey=$('#gk').value.trim();localStorage.gmodel=$('#gm').value.trim();toast('সেভ হয়েছে')">সেভ</button><button class=ok onclick="testKey()">🔌 পরীক্ষা করো</button></div></div>
  <div class=card><h3>🎨 থিম</h3><div class=row><button class=ghost onclick="theme('light')">☀️ লাইট</button><button class=ghost onclick="theme('dark')">🌙 ডার্ক</button></div></div>
  <div class=card><p>${esc(S.user.email||S.user.displayName||"")}</p><div class=row><button class=ghost onclick="auth.signOut()">লগ আউট</button><button class=no onclick="delAcc()">🗑 অ্যাকাউন্ট মুছুন</button></div></div>`;
}
const theme=t=>{localStorage.t=t;document.documentElement.dataset.t=t;render()};
if(ready)auth.onAuthStateChanged(async u=>{S.user=u;if(u){try{await load()}catch(e){toast("ডাটা আনা যায়নি: "+e.code)}}render()});
render();
</script>
</body>
</html>
