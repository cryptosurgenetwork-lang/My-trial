<script>
// ====== Firebase config: বসান Firebase Console > Project Settings > Web App থেকে ======
const FIREBASE_CONFIG={apiKey:"AIzaSyATlpz3B40-H0xWfoK1FdL4xgAVI4y5HCE",authDomain:"ssc-e4a96.firebaseapp.com",projectId:"ssc-e4a96",storageBucket:"ssc-e4a96.firebasestorage.app",messagingSenderId:"482064243850",appId:"1:482064243850:web:40930798bf10381895e173"};
const MODEL="gemini-2.5-flash";
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const $=s=>document.querySelector(s);
const esc=s=>String(s??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const bn=n=>String(n).replace(/\d/g,d=>"০১২৩৪৫৬৭৮৯"[d]);
const S={user:null,qs:[],tab:"home",pages:[],busy:false,rev:null,flip:false,show:{},filter:"সব",out:[],open:{},f:{}};
let db,auth;
const ready=FIREBASE_CONFIG.apiKey;
if(ready){firebase.initializeApp(FIREBASE_CONFIG);auth=firebase.auth();db=firebase.firestore();}
document.documentElement.dataset.t=localStorage.t||"light";
const toast=m=>{const d=document.createElement("div");d.className="toast";d.textContent=m;document.body.append(d);setTimeout(()=>d.remove(),2800)};
const confetti=()=>{for(let i=0;i<22;i++){const e=document.createElement("div");e.className="cf";e.textContent=["🎉","⭐","✨","🌈","💜"][i%5];e.style.left=Math.random()*100+"%";e.style.animationDelay=Math.random()*.5+"s";document.body.append(e);setTimeout(()=>e.remove(),2300)}};

// ---------- Data ----------
const col=()=>db.collection("users").doc(S.user.uid).collection("questions");
async function load(){const s=await col().orderBy("createdAt","desc").get();S.qs=s.docs.map(d=>({id:d.id,...d.data()}))}
const due=()=>S.qs.filter(q=>q.saved&&(q.due||0)<=Date.now()).sort((a,b)=>(a.due||0)-(b.due||0));
// সহজ স্পেসড-রিপিটিশন: মনে থাকলে ব্যবধান বাড়ে, না থাকলে ১০ মিনিট পর আবার
async function grade(q,ok){
  let ease=q.ease||2.3,iv=q.interval||0;
  if(ok){iv=iv<1?1:Math.round(iv*ease);ease=Math.min(3,ease+.05);q.due=Date.now()+iv*864e5;confetti()}
  else{iv=0;ease=Math.max(1.3,ease-.2);q.due=Date.now()+6e5}
  Object.assign(q,{ease,interval:iv,reviews:(q.reviews||0)+1,lastOk:ok});
  await col().doc(q.id).update({ease,interval:iv,due:q.due,reviews:q.reviews,lastOk:ok});
  S.flip=false;render();
}

// ---------- Gemini (ব্রাউজার থেকে সরাসরি; কী শুধু আপনার ডিভাইসে থাকে) ----------
const SCHEMA={type:"ARRAY",items:{type:"OBJECT",properties:{cat:{type:"STRING",enum:["ক","খ","গ","ঘ"]},q:{type:"STRING"},marks:{type:"INTEGER"},answer:{type:"STRING"},explanation:{type:"STRING"},importance:{type:"STRING",enum:["উচ্চ","মধ্যম","কম"]},source:{type:"STRING"}},required:["cat","q","marks","answer","explanation","importance"]}};
const MODELS=["gemini-2.5-flash","gemini-flash-latest","gemini-2.0-flash"];
// "AIza…" কী = Google AI Studio, "AQ.…" কী = Vertex AI Express; দুটোই সমর্থিত
async function gemini(parts,schema){
  const key=(localStorage.gkey||"").trim();if(!key)throw new Error("সেটিংসে Gemini API কী বসান");
  const body=JSON.stringify({contents:[{role:"user",parts}],generationConfig:{temperature:.4,...(schema?{responseMimeType:"application/json",responseSchema:schema}:{})}});
  const vertex=key.startsWith("AQ.");
  const list=[...new Set([(localStorage.gmodel||"").trim(),...MODELS].filter(Boolean))];
  const urls=[];
  list.forEach(m=>{urls.push(`https://generativelanguage.googleapis.com/v1beta/models/${m}:generateContent`);if(vertex)urls.push(`https://aiplatform.googleapis.com/v1/publishers/google/models/${m}:generateContent`)});
  const post=async(url,n)=>{
    let r;try{r=await fetch(url,{method:"POST",headers:{"Content-Type":"application/json","x-goog-api-key":key},body})}
    catch(e){throw new Error("ইন্টারনেট নেই, অথবা কীটি এই ডোমেইনে সীমাবদ্ধ")}
    if(r.status===429&&n<1){await sleep(3000);return post(url,n+1)}
    return r;
  };
  // লুপের বদলে রিকার্সন: কিছু প্রিভিউ টুল দীর্ঘ লুপ কেটে দেয়
  const run=async(k,first)=>{
    if(k>=urls.length)throw new Error("এআই ত্রুটি "+first);
    const r=await post(urls[k],0);
    if(r.ok){const j=await r.json();const t=j.candidates?.[0]?.content?.parts?.map(x=>x.text||"").join("");if(!t)throw new Error("এআই কোনো উত্তর দেয়নি (কনটেন্ট ব্লক হতে পারে)");return t}
    const j=await r.json().catch(()=>({}));const msg=r.status+" · "+(j.error?.message||"").slice(0,150);
    if((r.status===404||r.status===403)&&k+1<urls.length)return run(k+1,first||msg);
    throw new Error("এআই ত্রুটি "+(first||msg));
  };
  return run(0,"");
}
const busy=m=>{let e=$("#busy");if(!m){e&&e.remove();return}if(!e){e=document.createElement("div");e.id="busy";e.className="toast";document.body.append(e)}e.innerHTML='<span class=sp></span> '+m};
const b64=f=>new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(r.result.split(",")[1]);r.onerror=rej;r.readAsDataURL(f)});
async function addFiles(files){
  const ok=[...files].filter(f=>{
    if(!(/^image\/(jpeg|png|webp)$/.test(f.type)||f.type==="application/pdf")){toast("শুধু JPG, PNG, WEBP বা PDF চলবে");return false}
    if(f.size>10e6){toast("ফাইল ১০ MB-এর কম হতে হবে");return false}
    return true});
  const add=await Promise.all(ok.map(async f=>({name:f.name,type:f.type,data:await b64(f),url:f.type.startsWith("image")?URL.createObjectURL(f):""})));
  S.pages.push(...add);render();
}
async function readPages(){
  const parts=S.pages.map(p=>({inlineData:{mimeType:p.type,data:p.data}}));
  parts.push({text:"এই পাঠ্যবইয়ের পৃষ্ঠাগুলো থেকে সম্পূর্ণ লেখা হুবহু তুলে দাও। কিছু যোগ বা বাদ দেবে না। পৃষ্ঠা আলাদা করতে '--- পৃষ্ঠা N ---' লিখবে। পড়া না গেলে '[অস্পষ্ট]' লিখবে।"});
  return gemini(parts);
}
async function makeQuestions(txt,m){
  const p=`তুমি বাংলাদেশের এইচএসসি শিক্ষক। শুধু নিচের পাঠ্য থেকে প্রশ্ন বানাও। পাঠ্যে না থাকা তথ্য, উদ্ধৃতি বা পৃষ্ঠা নম্বর বানাবে না; তথ্য কম হলে কম প্রশ্ন দাও।
বিষয়: ${m.sub}। অধ্যায়: ${m.chap}। ধরন: ${m.cats.join(", ")} (ক=জ্ঞানমূলক ১ নম্বর, খ=অনুধাবনমূলক ২, গ=প্রয়োগমূলক ৩, ঘ=উচ্চতর দক্ষতা ৪)। মোট প্রশ্ন: ${m.num}টি, ধরনগুলোতে সমানভাবে ভাগ করে। কঠিনতা: ${m.dif}। উত্তরের দৈর্ঘ্য: ${m.len}।
গ ও ঘ-এর ক্ষেত্রে প্রথমে সংক্ষিপ্ত উদ্দীপক লিখে প্রশ্ন করো। importance হলো পড়ার অগ্রাধিকার, পরীক্ষায় আসার ভবিষ্যদ্বাণী নয়। source-এ পাঠ্যের সংশ্লিষ্ট পৃষ্ঠা/অংশ লেখো, না থাকলে ফাঁকা রাখো।
পাঠ্য:\n${txt.slice(0,30000)}`;
  let arr;try{arr=JSON.parse(await gemini([{text:p}],SCHEMA))}catch(e){if(e instanceof SyntaxError)throw new Error("এআই-এর উত্তর ভুল ফরম্যাটে এসেছে, আবার চেষ্টা করুন");throw e}
  arr=(Array.isArray(arr)?arr:[]).filter(x=>x.q&&x.answer).map(x=>({...x,subject:m.sub,chapter:m.chap}));
